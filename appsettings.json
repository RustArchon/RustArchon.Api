{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=RustArchon;Username=rustarchon;Password="
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // SecretKey deliberately absent - see JwtTokenOptions (JumpStart, ADR-016) and this project's
  // Program.cs; it comes from the flat RUSTARCHON_JWT_SECRET_KEY key below instead.
  "JwtSettings": {
    "Issuer": "RustArchonBlazorServer",
    "Audience": "RustArchonApi",
    "ExpirationMinutes": 60
  },
  "CorsSettings": {
    "BlazorServerUrl": "https://localhost:7199"
  },
  // Host/VirtualHost aren't secret and aren't shared with the RabbitMQ container's own config, so they
  // stay nested here. Username/Password are deliberately absent - see RabbitMqOptions's remarks; they
  // come from the flat RABBITMQ_DEFAULT_USER/PASS keys below instead.
  "RabbitMq": {
    "Host": "rabbitmq",
    "VirtualHost": "/"
  },
  // Deliberately absent by default (unlike RabbitMq above) - see PlatformSettingsCache's remarks: no
  // configured connection string means it's simply never registered, and every settings read goes
  // straight to Postgres. docker-compose.yml's rustarchon-api service overrides this to "valkey:6379".
  "Valkey": {
    "ConnectionString": ""
  },

  // The keys below are read directly by name (not as nested sections) so the exact same name is used
  // in appsettings, in .env, and in docker-compose.yml's environment blocks - no Section:Key rename
  // step in between. RABBITMQ_DEFAULT_USER/PASS additionally match the RabbitMQ container's own
  // required names exactly, rather than a RustArchon-specific rename. See
  // InvitationCodeOptions/InternalApiKeyOptions/RabbitMqOptions/Program.cs's "PlatformAdmin" policy
  // setup for where each of these is actually read.
  "RUSTARCHON_INVITATION_CODES_ENABLED": true,
  "RUSTARCHON_ADMIN_EMAIL": "",
  "RUSTARCHON_ADMIN_CODE": "",
  "RUSTARCHON_INTERNAL_API_KEY": "",
  "RUSTARCHON_JWT_SECRET_KEY": "",
  "RABBITMQ_DEFAULT_USER": "",
  "RABBITMQ_DEFAULT_PASS": ""
}
