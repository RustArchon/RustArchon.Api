<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>rustarchon-api-3f0e9c9a-2c1e-4a7e-9e3a-2b6f2c1d4a8b</UserSecretsId>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <!-- Reads (never runs) an uploaded plugin file as C# 7.3 - the language the game server's compiler accepts - so a file that cannot compile is
         refused at upload, before anyone can publish it. See PluginSourceSyntax. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Valkey speaks the Redis protocol, so the standard Redis client works against it unmodified. -->
    <PackageReference Include="StackExchange.Redis" Version="3.2.1" />
    <!-- Pinned to the last open-source MassTransit release - v9 is commercial. See README. -->
    <PackageReference Include="MassTransit" Version="[8.5.10]" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="[8.5.10]" />
    <!-- Stripe Checkout only (payment mode, one already-priced invoice at a time) - never Stripe's own
         Subscriptions/Billing product, which can't express PlanChangeCalculator's proration model. See
         StripeCheckoutService's remarks. -->
    <PackageReference Include="Stripe.net" Version="52.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RustArchon.Shared\RustArchon.Shared.csproj" />
    <ProjectReference Include="..\RustArchon.Messaging\RustArchon.Messaging.csproj" />
    <ProjectReference Include="..\JumpStart\JumpStart\JumpStart.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DefaultThemeSeeder's embedded copy of the built-in "RustArchon" theme package - see that
         class's own remarks on why this is a copy of RustArchon.Panel's wwwroot/app.css, not the
         source of truth. Explicit LogicalName rather than relying on the SDK's default
         namespace-plus-path convention, so DefaultThemeSeeder's resource-name string is obviously
         correct by inspection rather than by knowing that convention. -->
    <EmbeddedResource Include="Administration\DefaultTheme\manifest.json">
      <LogicalName>RustArchon.Api.Administration.DefaultTheme.manifest.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Administration\DefaultTheme\theme.css">
      <LogicalName>RustArchon.Api.Administration.DefaultTheme.theme.css</LogicalName>
    </EmbeddedResource>

    <!-- The RustArchon companion plugin's source, from the sibling RustArchon.Plugin repo. This Panel stamps its own
         public signing key into it and signs it when it is downloaded (see PluginScriptService), so the plugin's
         version always tracks the Panel's. It is only embedded, never compiled here: it targets the game server's
         framework, not this one. Sibling-relative like the other project references; the Dockerfile copies that
         folder in for the same reason. -->
    <EmbeddedResource Include="..\RustArchon.Plugin\src\RustArchon.cs">
      <LogicalName>RustArchon.Plugin.RustArchon.cs</LogicalName>
    </EmbeddedResource>

    <!-- The Updater: the second, separate plugin that swaps the main one and rolls back on failure. Served signed the
         same way, but only ever installed by hand - a failed Updater would have nothing left to recover it. -->
    <EmbeddedResource Include="..\RustArchon.Plugin\src\RustArchonUpdater.cs">
      <LogicalName>RustArchon.Plugin.RustArchonUpdater.cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
